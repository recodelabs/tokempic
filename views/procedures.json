{
  "resourceType": "ViewDefinition",
  "status": "active",
  "name": "procedures",
  "resource": "Procedure",
  "where": [
    {
      "path": "status.where($this = 'entered-in-error').empty()"
    }
  ],
  "select": [
    {
      "column": [
        {
          "name": "code",
          "path": "code.coding.first().code"
        },
        {
          "name": "display",
          "path": "iif(code.coding.first().display.exists(), code.coding.first().display, code.text)"
        },
        {
          "name": "status",
          "path": "status"
        },
        {
          "name": "performed",
          "path": "performed.ofType(dateTime) | performed.ofType(Period).start"
        }
      ]
    }
  ]
}
